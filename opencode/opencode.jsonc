{
  "$schema": "https://opencode.ai/config.json",
  // Plugins privilegies : les versions sont epinglees pour eviter qu'une
  // publication npm ulterieure s'execute automatiquement avec acces aux jetons
  // OAuth.
  //
  // opencode-warp : notifications de fin de tour vers Warp. Audit de la 0.1.7,
  // aucun appel reseau — le plugin ecrit seulement une sequence OSC 777 sur
  // /dev/tty, donc tout reste dans le terminal. Il lit en revanche la
  // conversation via l'API locale et place dans la notification jusqu'a 200
  // caracteres du dernier prompt et de la derniere reponse, le cwd complet, et
  // pour une demande de permission la metadata integrale (donc la commande
  // shell en entier). Inerte si WARP_CLI_AGENT_PROTOCOL_VERSION est absente.
  "plugin": [
    "@ex-machina/opencode-anthropic-auth@1.8.1",
    "@warp-dot-dev/opencode-warp@0.1.7"
  ],
  // Codex is the default orchestrator. Claude remains selectable when an
  // Anthropic-only contingent is preferable or OpenAI quota is constrained.
  "default_agent": "codex",
  // small_model sert les taches legeres. Il passe cote OpenAI avec le reste du
  // volume subi, pour que le quota Anthropic soit consomme par le raisonnement
  // (analyse, plan, build) et pas par la plomberie.
  "small_model": "openai/gpt-5.6-luna",

  // Couche d'instructions machine-locale. AGENTS.md est portable et versionne;
  // AGENTS.local.md contient l'identite et la topologie de la machine (hotes,
  // ports, utilisateurs, forwards) et n'entre jamais dans ce depot — il est
  // dans le .gitignore. Verifie : un fichier d'instructions absent ne bloque
  // pas le demarrage, donc un clone frais fonctionne sans le creer.
  "instructions": ["AGENTS.local.md"],

  // Prem API chiffre de bout en bout (TEE + XWing) : opencode ne peut pas
  // parler directement a gateway.prem.io, qui n'accepte que du ciphertext. Le
  // Confidential Proxy @premai/api-sdk fait le chiffrement cote client et
  // expose une surface OpenAI-compatible sur 127.0.0.1:8787. Voir
  // docs.prem.io/confidential-proxy et ADR-0011.
  //
   // Pre-requis (a lancer dans un shell persistant, pas ici — le process group
   // de bash est tue a la fin de chaque commande) :
   //   PREM_API_KEY="$(cat ~/.secrets/prem-api-key)" \
   //   confidential-proxy start --compat openai \
   //     --kek "$(cat ~/.secrets/prem-client-kek)"
   //
   // PROXY_URL et ENCLAVE_URL restent exportes depuis ~/.profile : ce sont des
   // URLs publiques, pas des secrets. En revanche PREM_API_KEY et CLIENT_KEK
   // n'y sont plus et sont fournis a la commande, pas a la session : un secret
   // exporte dans ~/.profile est lisible par toute commande shell lancee par
   // un agent. La KEK se genere avec "openssl rand -hex 32" et n'est connue
   // que de toi. Le CLI ne la lit pas depuis l'environnement : --kek est
   // obligatoire. Les URLs courantes viennent de
   // https://dashboard.prem.io/endpoints.json.
  "provider": {
    "prem": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Prem",
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1",
        // {file:...} plutot que {env:...} : la cle n'a plus besoin d'exister
        // dans l'environnement du process, donc elle sort de l'environnement
        // de chaque commande shell lancee par un agent. Chemin absolu en ~,
        // supporte et documente, donc le fichier reste portable. Le fichier
        // est ecrit SANS saut de ligne final : le contenu est inline tel quel.
        "apiKey": "{file:~/.secrets/prem-api-key}",
        "timeout": 600000,
        "chunkTimeout": 60000
      },
      "models": {
        "glm-5.2": {
          "name": "GLM 5.2",
          "tool_call": true,
          // Limites non publiees par Prem : estimations prudentes, a verifier.
          "limit": { "context": 128000, "output": 16384 }
        },
        "qwen36-27b": {
          "name": "Qwen 3.6 27B",
          "tool_call": true,
          "attachment": true,
          "limit": { "context": 128000, "output": 16384 }
        }
        // kimi-k3 a ete retire d'ici : GET /v1/models sur le proxy confidentiel
        // ne le sert pas (qwen36-27b, deepseek-v4-pro, glm-5.2 uniquement).
        // L'entree n'avait jamais pu fonctionner. Il vit sur prem-router.
      }
    },

    // ATTENTION — chemin NON chiffre de bout en bout, contrairement a "prem".
    // router.prem.io est un service distinct de gateway.prem.io : c'est un
    // routeur OpenAI-compatible classique, en TLS simple. Prem voit donc les
    // prompts en clair. Kimi reste disponible par selection manuelle du modele,
    // mais aucun agent preconfigure ne route automatiquement un depot vers lui.
    // Verifie : cert CN=prem.io, meme IP Cloudflare que conf-engine.prem.io.
    //
    // Cle DEDIEE, distincte de PREM_API_KEY : la cle confidentielle suffixee
    // _pcci authentifie GET /v1/models sur le routeur mais est refusee sur
    // /v1/chat/completions ("invalid_api_key", renvoie vers
    // api.premai.io/settings/api-keys). Ce sont deux credentials separes.
    //
    // La cle vit desormais dans ~/.secrets/prem-router-api-key, lue via
    // {file:...} au chargement de la config. Elle n'est plus dans
    // l'environnement, donc le piege precedent — un opencode demarre avant
    // l'export resolvait {env:...} sur une chaine vide et le routeur
    // repondait "invalid_api_key", symptome identique a une mauvaise cle —
    // disparait. En revanche la config n'est pas rechargee a chaud : apres
    // edition du fichier de cle, redemarrer opencode.
    "prem-router": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Prem Router (non chiffre)",
      "options": {
        "baseURL": "https://router.prem.io/v1",
        "apiKey": "{file:~/.secrets/prem-router-api-key}",
        // Absents avant : sans chunkTimeout, un flux SSE qui se tait ne
        // s'interrompt jamais tout seul, ce qui ressemblait a un "crash" en
        // usage multi-agents concurrents (plusieurs kimi-k3 en parallele).
        // headerTimeout borne l'attente des entetes de reponse separement du
        // timeout global.
        "timeout": 600000,
        "headerTimeout": 120000,
        "chunkTimeout": 60000
      },
      "models": {
        "kimi-k3": {
          "name": "Kimi K3",
          // Verifie par appel reel sur /v1/chat/completions : le modele emet
          // bien un tool_call OpenAI-compatible (function.arguments en JSON).
          // Note : les reponses portent un champ "reasoning_content" en plus
          // de "content", et "content" peut etre vide quand un outil est
          // appele.
          "tool_call": true,
          "attachment": true,
          "reasoning": true,
          // context confirme par GET /v1/models (context_length: 1000000).
          // output non publie par Prem : estimation prudente, a verifier.
          "limit": { "context": 1000000, "output": 16384 },
          // Variantes d'effort de raisonnement, choisies par agent via
          // "variant". Non verifie que le routeur honore reasoningEffort
          // (options passees telles quelles au SDK openai-compatible) — a
          // confirmer par un appel reel si la vitesse ne bouge pas.
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "max": { "reasoningEffort": "max" }
          }
        }
      }
    }
  },

  // Jamais de partage implicite : une session contient le code de depots prives.
  "share": "disabled",

  // Reduit le contexte des longues sessions en retirant les anciens resultats
  // d'outils apres compaction; l'historique persiste dans la base locale.
  "compaction": {
    "auto": true,
    "prune": true,
    // Conserver deux tours est le defaut 1.18.16 et minimise le contexte
    // retransmis apres compaction. Six tours favoriseraient la fidelite, pas la
    // vitesse visee ici.
    "tail_turns": 2,
    "reserved": 10000
  },

  // La profondeur 1 interdit aux workers et explorateurs de relancer leurs
  // propres sous-agents. C'est deja le defaut runtime, mais l'expliciter rend
  // la borne stable et visible.
  "subagent_depth": 1,

  // Le resultat complet reste disponible dans le repertoire de troncature;
  // seul l'aperçu injecte dans le contexte est borne.
  "tool_output": {
    "max_lines": 500,
    "max_bytes": 32768
  },

  // Posture : autorisation par defaut, refus explicite la ou c'est necessaire.
  // C'est aussi le defaut d'opencode lui-meme ("by default, opencode allows all
  // operations without requiring explicit approval").
  //
  // Le prompt de permission n'etait de toute facon pas une sandbox — les
  // plugins s'executent dans le processus opencode, hors de ce modele. Les
  // depots non fiables doivent etre ouverts avec OPENCODE_PURE=1 et
  // OPENCODE_DISABLE_PROJECT_CONFIG=1. Voir docs/decisions/0003.
  //
  // Consequence directe de ce choix : plus rien n'arrete une commande shell
  // avant son execution. Les seuls garde-fous restants sont les refus etroits
  // ci-dessous, et ils ne portent que sur des chemins.
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": "allow",
    "bash": "allow",
    "doom_loop": "deny",
    "imagegen": "ask",
    "image-display": "ask",
    // external_directory gate egalement les chemins detectes dans de nombreuses
    // commandes shell. Les repertoires entiers sont refuses car le controle se
    // fait sur un glob de parent, pas necessairement sur le fichier exact.
    //
    // Un "*" couvre plusieurs segments : le refus de ~/.local/share/opencode/*
    // atteint donc aussi plans/. Il doit etre suivi d'une re-autorisation
    // etroite, sinon l'edition de plans autorisee a l'agent plan est morte —
    // c'etait le cas, et le refus se declenchait sans que rien ne le signale.
    // auth.json reste couvert par le refus. Voir docs/decisions/0002.
    //
    // L'ordre compte : opencode applique la DERNIERE regle qui matche, donc le
    // "*" permissif doit rester en tete et les refus en queue.
    "external_directory": {
      "*": "allow",
      "~/.ssh/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.aws/*": "deny",
      "~/.config/gh/*": "deny",
      "~/.secrets/*": "deny",
      "~/.codex/*": "deny",
      "~/.local/share/opencode/*": "deny",
      "~/.local/share/opencode/plans/*": "allow"
    }
  },
  "agent": {
    // Only Codex and Claude are visible. The built-in profiles are replaced by
    // four hidden, provider-affine agents selected by the primary orchestrator.
    "build": { "disable": true },
    "general": { "disable": true },
    "plan": { "disable": true },
    "explore": { "disable": true },
    "scout": { "disable": true },
    "codex": {
      "description": "Default GPT-5.6 Sol orchestrator; delegates analysis to Luna and implementation or Git integration to Ines on Luna.",
      "mode": "primary",
      "model": "openai/gpt-5.6-sol",
      "variant": "high",
      "prompt": "{file:./prompts/primary.md}",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "question": "allow",
        "doom_loop": "deny",
        "task": {
          "*": "deny",
          "analyst-openai": "allow",
          "worker-openai": "allow"
        }
      }
    },
    "claude": {
      "description": "Claude Opus 5 orchestrator; keeps every delegated analysis, implementation, and Git integration task on Anthropic Sonnet 5.",
      "mode": "primary",
      "model": "anthropic/claude-opus-5",
      "variant": "high",
      "prompt": "{file:./prompts/primary.md}",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "question": "allow",
        "doom_loop": "deny",
        "task": {
          "*": "deny",
          "analyst-anthropic": "allow",
          "worker-anthropic": "allow"
        }
      }
    },
    "analyst-openai": {
      "description": "Read-only Luna analyst. Delegate with PROFILE: constance for research and planning, PROFILE: raoul for review and verification, or PROFILE: arsene for authorized offensive security analysis.",
      "mode": "subagent",
      "hidden": true,
      "model": "openai/gpt-5.6-luna",
      "variant": "medium",
      "prompt": "{file:./prompts/analyst.md}",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "skill": "allow",
        "bash": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "analyst-anthropic": {
      "description": "Read-only Sonnet analyst. Delegate with PROFILE: constance for research and planning, PROFILE: raoul for review and verification, or PROFILE: arsene for authorized offensive security analysis.",
      "mode": "subagent",
      "hidden": true,
      "model": "anthropic/claude-sonnet-5",
      "variant": "low",
      "prompt": "{file:./prompts/analyst.md}",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "skill": "allow",
        "bash": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "worker-openai": {
      "description": "Ines on OpenAI Luna. Implements one cohesive change or performs explicitly requested Git integration; never share files, the Git index, or mutable resources with another worker.",
      "mode": "subagent",
      "hidden": true,
      "model": "openai/gpt-5.6-luna",
      "variant": "medium",
      "prompt": "{file:./prompts/worker.md}",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "skill": "allow",
        "edit": "allow",
        "bash": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "worker-anthropic": {
      "description": "Ines on Anthropic Sonnet 5. Implements one cohesive change or performs explicitly requested Git integration; never share files, the Git index, or mutable resources with another worker.",
      "mode": "subagent",
      "hidden": true,
      "model": "anthropic/claude-sonnet-5",
      "variant": "low",
      "prompt": "{file:./prompts/worker.md}",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "skill": "allow",
        "edit": "allow",
        "bash": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },

    // --- Agents systeme caches ----------------------------------------------
    // Verifie avec "opencode debug agent <nom>" : sans modele explicite, ces
    // trois-la n'heritent pas de small_model, ils heritent du modele de la
    // SESSION. Sans cette surcharge, une session flagship pourrait donc
    // compacter avec Kimi, Sol ou Opus au lieu d'un modele auxiliaire rapide.
    //
    // Ils ne sont pas selectionnables dans l'interface; on ne peut les
    // corriger qu'en redefinissant la cle ici.
    "compaction": {
      // Luna est concu pour les charges rapides a fort volume et dispose du
      // meme contexte de 1,05M tokens que les flagships GPT-5.6.
      "model": "openai/gpt-5.6-luna"
    },
    "title": {
      "model": "openai/gpt-5.6-luna"
    },
    "summary": {
      "model": "openai/gpt-5.6-luna"
    }
  }
}
