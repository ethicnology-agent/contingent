{
  "$schema": "https://opencode.ai/config.json",
  // Plugins privilegies : les versions sont epinglees pour eviter qu'une
  // publication npm ulterieure s'execute automatiquement avec acces aux jetons
  // OAuth.
  //
  // opencode-warp : notifications de fin de tour vers Warp. Audit de la 0.1.7,
  // aucun appel reseau — le plugin ecrit seulement une sequence OSC 777 sur
  // /dev/tty, donc tout reste dans le terminal. Il lit en revanche la
  // conversation via l'API locale et place dans la notification jusqu'a 200
  // caracteres du dernier prompt et de la derniere reponse, le cwd complet, et
  // pour une demande de permission la metadata integrale (donc la commande
  // shell en entier). Inerte si WARP_CLI_AGENT_PROTOCOL_VERSION est absente.
  "plugin": [
    "@ex-machina/opencode-anthropic-auth@1.8.1",
    "@warp-dot-dev/opencode-warp@0.1.7"
  ],
  "default_agent": "analyse",
  "small_model": "anthropic/claude-haiku-4-5",

  // Couche d'instructions machine-locale. AGENTS.md est portable et versionne;
  // AGENTS.local.md contient l'identite et la topologie de la machine (hotes,
  // ports, utilisateurs, forwards) et n'entre jamais dans ce depot — il est
  // dans le .gitignore. Verifie : un fichier d'instructions absent ne bloque
  // pas le demarrage, donc un clone frais fonctionne sans le creer.
  "instructions": ["AGENTS.local.md"],

  // Prem API chiffre de bout en bout (TEE + XWing) : opencode ne peut pas
  // parler directement a gateway.prem.io, qui n'accepte que du ciphertext. Le
  // Confidential Proxy @premai/api-sdk fait le chiffrement cote client et
  // expose une surface OpenAI-compatible sur 127.0.0.1:8787. Voir
  // docs.prem.io/confidential-proxy et ADR-0011.
  //
   // Pre-requis (a lancer dans un shell persistant, pas ici — le process group
   // de bash est tue a la fin de chaque commande) :
   //   PREM_API_KEY="$(cat ~/.secrets/prem-api-key)" \
   //   confidential-proxy start --compat openai \
   //     --kek "$(cat ~/.secrets/prem-client-kek)"
   //
   // PROXY_URL et ENCLAVE_URL restent exportes depuis ~/.profile : ce sont des
   // URLs publiques, pas des secrets. En revanche PREM_API_KEY et CLIENT_KEK
   // n'y sont plus et sont fournis a la commande, pas a la session : un secret
   // exporte dans ~/.profile est lisible par toute commande shell lancee par
   // un agent. La KEK se genere avec "openssl rand -hex 32" et n'est connue
   // que de toi. Le CLI ne la lit pas depuis l'environnement : --kek est
   // obligatoire. Les URLs courantes viennent de
   // https://dashboard.prem.io/endpoints.json.
  "provider": {
    "prem": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Prem",
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1",
        // {file:...} plutot que {env:...} : la cle n'a plus besoin d'exister
        // dans l'environnement du process, donc elle sort de l'environnement
        // de chaque commande shell lancee par un agent. Chemin absolu en ~,
        // supporte et documente, donc le fichier reste portable. Le fichier
        // est ecrit SANS saut de ligne final : le contenu est inline tel quel.
        "apiKey": "{file:~/.secrets/prem-api-key}",
        "timeout": 600000,
        "chunkTimeout": 60000
      },
      "models": {
        "glm-5.2": {
          "name": "GLM 5.2",
          "tool_call": true,
          // Limites non publiees par Prem : estimations prudentes, a verifier.
          "limit": { "context": 128000, "output": 16384 }
        },
        "qwen36-27b": {
          "name": "Qwen 3.6 27B",
          "tool_call": true,
          "attachment": true,
          "limit": { "context": 128000, "output": 16384 }
        }
        // kimi-k3 a ete retire d'ici : GET /v1/models sur le proxy confidentiel
        // ne le sert pas (qwen36-27b, deepseek-v4-pro, glm-5.2 uniquement).
        // L'entree n'avait jamais pu fonctionner. Il vit sur prem-router.
      }
    },

    // ATTENTION — chemin NON chiffre de bout en bout, contrairement a "prem".
    // router.prem.io est un service distinct de gateway.prem.io : c'est un
    // routeur OpenAI-compatible classique, en TLS simple. Prem voit donc les
    // prompts en clair. A ne pas utiliser pour du code de depot prive.
    // Verifie : cert CN=prem.io, meme IP Cloudflare que conf-engine.prem.io.
    //
    // Cle DEDIEE, distincte de PREM_API_KEY : la cle confidentielle suffixee
    // _pcci authentifie GET /v1/models sur le routeur mais est refusee sur
    // /v1/chat/completions ("invalid_api_key", renvoie vers
    // api.premai.io/settings/api-keys). Ce sont deux credentials separes.
    //
    // La cle vit desormais dans ~/.secrets/prem-router-api-key, lue via
    // {file:...} au chargement de la config. Elle n'est plus dans
    // l'environnement, donc le piege precedent — un opencode demarre avant
    // l'export resolvait {env:...} sur une chaine vide et le routeur
    // repondait "invalid_api_key", symptome identique a une mauvaise cle —
    // disparait. En revanche la config n'est pas rechargee a chaud : apres
    // edition du fichier de cle, redemarrer opencode.
    "prem-router": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Prem Router (non chiffre)",
      "options": {
        "baseURL": "https://router.prem.io/v1",
        "apiKey": "{file:~/.secrets/prem-router-api-key}"
      },
      "models": {
        "kimi-k3": {
          "name": "Kimi K3",
          // Verifie par appel reel sur /v1/chat/completions : le modele emet
          // bien un tool_call OpenAI-compatible (function.arguments en JSON).
          // Note : les reponses portent un champ "reasoning_content" en plus
          // de "content", et "content" peut etre vide quand un outil est
          // appele.
          "tool_call": true,
          "attachment": true,
          "reasoning": true,
          // context confirme par GET /v1/models (context_length: 1000000).
          // output non publie par Prem : estimation prudente, a verifier.
          "limit": { "context": 1000000, "output": 16384 }
        }
      }
    }
  },

  // Jamais de partage implicite : une session contient le code de depots prives.
  "share": "disabled",

  // Reduit le contexte des longues sessions en retirant les anciens resultats
  // d'outils apres compaction; l'historique persiste dans la base locale.
  "compaction": {
    "auto": true,
    "prune": true
  },

  // Les permissions reduisent l'exposition mais ne constituent pas une sandbox.
  // En particulier, les plugins s'executent dans le processus opencode, hors de
  // ce modele. Les depots non fiables doivent etre ouverts avec OPENCODE_PURE=1
  // et OPENCODE_DISABLE_PROJECT_CONFIG=1. Voir docs/decisions/0003.
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    // external_directory gate egalement les chemins detectes dans de nombreuses
    // commandes shell. Les repertoires entiers sont refuses car le controle se
    // fait sur un glob de parent, pas necessairement sur le fichier exact.
    //
    // Un "*" couvre plusieurs segments : le refus de ~/.local/share/opencode/*
    // atteint donc aussi plans/. Il doit etre suivi d'une re-autorisation
    // etroite, sinon l'edition de plans autorisee a l'agent plan est morte —
    // c'etait le cas, et le refus se declenchait sans que rien ne le signale.
    // auth.json reste couvert par le refus. Voir docs/decisions/0002.
    "external_directory": {
      "*": "ask",
      "~/.ssh/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.aws/*": "deny",
      "~/.config/gh/*": "deny",
      "~/.local/share/opencode/*": "deny",
      "~/.local/share/opencode/plans/*": "allow"
    },
    "bash": "ask"
  },
  "agent": {
    "analyse": {
      "description": "Discussion, analyse approfondie, architecture et diagnostic complexe. Utilise Anthropic en priorite.",
      "mode": "primary",
      "model": "anthropic/claude-opus-5",
      "variant": "high",
      // Cet agent est la pour raisonner, pas pour implementer — c'est le role
      // de build. "ask" plutot que "deny" : une frappe suffit si tu veux
      // vraiment qu'il corrige quelque chose au fil de la discussion.
      "permission": {
        "edit": "ask",
        "bash": "ask",
        "question": "allow",
        "task": {
          "*": "deny",
          "explore": "allow",
          "explore-openai": "allow",
          "scout": "allow"
        }
      }
    },
    "plan": {
      "mode": "primary",
      "model": "anthropic/claude-opus-5",
      "variant": "high",
      // {file:...} est resolu relativement a CE fichier : le prompt long vit
      // dans son propre markdown sans casser la portabilite du depot.
      "prompt": "{file:./prompts/plan.md}",
      // Reaffirme le refus d'edition du mode plan : le defaut natif est "ask",
      // et un "allow" global l'annulerait sinon.
      "permission": {
        "bash": "deny",
        "question": "allow",
        "task": {
          "*": "deny",
          "explore": "allow",
          "explore-openai": "allow",
          "scout": "allow"
        },
        "edit": {
          "*": "deny",
          ".opencode/plans/*.md": "allow",
          "~/.local/share/opencode/plans/*.md": "allow"
        }
      }
    },
    "build": {
      "mode": "primary",
      "model": "anthropic/claude-sonnet-5",
      "variant": "medium",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "question": "allow"
      }
    },
    "explore": {
      "mode": "subagent",
      "model": "anthropic/claude-haiku-4-5",
      "steps": 8,
      // Lecture seule reelle. La cle "edit" couvre deja write, edit et
      // apply_patch : l'ancien bloc "tools" faisait double emploi, et il est
      // deprecie depuis la v1.1.1 au profit de "permission".
      // bash est refuse : l'exploration passe par read/glob/grep, et un
      // subagent est le maillon le plus facile a detourner par injection
      // puisque tu ne relis pas ses actions.
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "analyse-openai": {
      "description": "Secours d'analyse et de planification lorsque la limite Anthropic est atteinte.",
      "mode": "primary",
      "model": "openai/gpt-5.6-sol",
      "variant": "high",
      "permission": {
        "edit": "ask",
        "bash": "ask",
        "question": "allow",
        "task": {
          "*": "deny",
          "explore": "allow",
          "explore-openai": "allow",
          "scout": "allow"
        }
      }
    },
    "build-openai": {
      "description": "Secours d'implementation lorsque la limite Anthropic est atteinte.",
      "mode": "primary",
      "model": "openai/gpt-5.6-terra",
      "variant": "medium",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "question": "allow"
      }
    },
    "explore-openai": {
      "description": "Secours rapide d'exploration en lecture seule.",
      "mode": "subagent",
      // Etait "openai/gpt-5.4-mini-fast", inexistant chez models.dev : ce
      // secours ne pouvait pas demarrer. Le suffixe "-fast" relevait du champ
      // "variant", distinct de l'identifiant du modele.
      "model": "openai/gpt-5.4-mini",
      "steps": 8,
      // Meme remarque que pour "explore" : "tools" etait deprecie et redondant
      // avec la cle "edit", qui gate deja write / edit / apply_patch.
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    }
  }
}
