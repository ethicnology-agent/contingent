# Etat et secrets machine-locaux : ne doivent jamais entrer dans ce depot,
# meme par erreur d'un futur commit. Voir docs/decisions/0003 et 0008.
node_modules/
__pycache__/
bun.lock
auth.json
# Instructions specifiques a la machine (hotes, ports, utilisateurs, forwards),
# chargees via "instructions" dans opencode.jsonc. Voir docs/decisions/0012.
AGENTS.local.md
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
id_ed25519*
*.db
*.db-*
*.log
backups/
install-state/
