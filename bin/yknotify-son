#!/usr/bin/env python3
"""Genere le carillon joue quand la YubiKey demande un contact.

Volontairement un generateur et non un fichier suivi : un WAV de 26 Ko est un
binaire qu'aucune relecture ne peut inspecter, alors que ces quelques lignes se
lisent. L'artefact reste donc machine-local.

    yknotify-son [chemin]        defaut : ~/.local/share/yknotify/touch.wav

Aucune dependance : seule la bibliotheque standard est utilisee. La VM n'a pas
besoin de peripherique audio, le fichier est lu ici puis streame vers le
serveur audio du poste (voir PULSE_SERVER et ADR-0005).
"""
from __future__ import annotations

import math
import os
import struct
import sys
import wave

TAUX = 44100
DEFAUT = "~/.local/share/yknotify/touch.wav"

# Quinte montante La5 -> Mi6. Choisie pour ne ressembler ni a un bip systeme ni
# a une notification d'application : ce son ne doit signifier qu'une chose.
NOTES = ((880.0, 0.11), (1318.5, 0.17))
BLANC = 0.02
AMPLI = 0.32


def ton(freq: float, duree: float):
    n = int(TAUX * duree)
    for i in range(n):
        # Enveloppe d'attaque/extinction : sans elle, la discontinuite au debut
        # et a la fin de la sinusoide s'entend comme un clic.
        env = min(1.0, i / (0.008 * TAUX), (n - i) / (0.03 * TAUX))
        yield int(32767 * AMPLI * env * math.sin(2 * math.pi * freq * i / TAUX))


def echantillons():
    premier = True
    for freq, duree in NOTES:
        if not premier:
            yield from (0 for _ in range(int(TAUX * BLANC)))
        premier = False
        yield from ton(freq, duree)


def main(argv: list[str]) -> int:
    cible = os.path.expanduser(argv[1] if len(argv) > 1 else DEFAUT)
    os.makedirs(os.path.dirname(cible) or ".", exist_ok=True)
    with wave.open(cible, "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(TAUX)
        w.writeframes(b"".join(
            struct.pack("<h", max(-32768, min(32767, s))) for s in echantillons()))
    with wave.open(cible) as w:
        duree = w.getnframes() / w.getframerate()
    print(f"{cible} : {duree:.2f} s, {TAUX} Hz, mono 16 bits")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
